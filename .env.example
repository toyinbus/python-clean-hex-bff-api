# python-clean-hex-bff-api environment variables
# Copy to `.env` for local development. NEVER commit a real `.env`.

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=python-clean-hex-bff-api
ENVIRONMENT=development
API_BASE_PATH=/api/v1
ENABLE_DOCS=true

# ── Logging ───────────────────────────────────────────────────────────────────
# LOG_FORMAT=console -> human-readable (dev); json -> structured for CloudWatch/Elastic (prod)
LOG_LEVEL=INFO
LOG_FORMAT=console
# LOG_BODIES: log request/response bodies (debug aid, redacted + truncated). Keep off in prod.
LOG_BODIES=false
LOG_BODY_MAX_BYTES=2048
# LOG_REDACT: mask sensitive fields in logged bodies. Keep true when deployed;
# set false only on a trusted local machine to inspect raw values while debugging.
LOG_REDACT=true

# ── REST server ───────────────────────────────────────────────────────────────
REST_API_HOST=0.0.0.0
REST_API_PORT=8080

# ── Pagination ────────────────────────────────────────────────────────────────
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ── Storage type ──────────────────────────────────────────────────────────────
# "memory"   -> mocked in-memory repo (default); no DB, nothing to check.
# "postgres" -> real repo; the pool is opened AND pinged at startup, so an
#               unreachable/misconfigured DB makes the app fail fast.
STORAGE_TYPE=memory

# ── Secrets / infrastructure (env only — never in code) ───────────────────────
# Used ONLY when STORAGE_TYPE=postgres. Ignored by the default memory demo.
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=app_db_dev
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_SEC=5
